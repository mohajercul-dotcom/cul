---
const colors = ["#c44536", "#2c7a68", "#b67c3c", "#5b6299", "#7a5c8a"];
const labels = ["سقفی", "کاجی", "برنز", "#5b6299", "#7a5c8a"];
---

<header>
  <div class="nav-group">
    <button class="icon-btn" id="homeBtn">
      <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="tooltip">خانه</span>
    </button>
    <button class="icon-btn" id="aboutBtn">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><circle cx="12" cy="8" r="1" fill="currentColor" stroke="none"/></svg>
      <span class="tooltip">درباره</span>
    </button>
  </div>

  <button class="logo-link" id="logoBtn">
    <img src="/mohajer.svg" alt="Mohajer" />
  </button>

  <div class="nav-group">
    <button class="icon-btn" id="themeToggle">
      <svg id="themeIcon" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="5"/>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <span class="tooltip" id="themeLabel">شب</span>
    </button>
    <div class="palette-wrap" id="paletteWrap">
      <button class="icon-btn" id="paletteBtn">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
        <span class="tooltip">رنگ</span>
      </button>
      <div class="palette-drop" id="paletteDrop">
        {colors.map((c, i) => (
          <span class="color-dot" style={`background:${c}`} data-color={c} title={labels[i]}></span>
        ))}
      </div>
    </div>
  </div>
</header>
