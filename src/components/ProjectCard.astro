---
export interface Props {
  name: string;
  desc: string;
  index: number;
  img?: string;
  logo?: string;
  pastel?: string;
  status: "completed" | "in-progress" | "queued";
}
const { name, desc, index, img, logo, pastel, status } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const isPastel = pastel !== undefined;
const style = isPastel ? `--i: ${index}; --pastel: ${pastel}` : `--i: ${index}; --img: url(${img})`;

const statusLabel: Record<string, string> = {
  "completed": "تکمیل شده",
  "in-progress": "در دست ساخت",
  "queued": "در نوبت",
};
---

<article class="card" class:list={{ "card-pastel": isPastel }} {style}>
  <span class="card-badge" data-status={status}>{statusLabel[status]}</span>
  {isPastel ? (
    <>
      <div class="card-bg-pastel"></div>
      <div class="card-overlay"></div>
      <div class="card-section card-section-top">
        {logo && <div class="card-logo"><img src={logo} alt="" /></div>}
      </div>
      <div class="card-section card-section-mid"></div>
      <div class="card-section card-section-btm">
        <div class="card-body">
          <div class="num">{num}</div>
          <h3>{name}</h3>
          <p>{desc}</p>
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="card-bg"></div>
      {logo && <div class="card-logo"><img src={logo} alt="" /></div>}
      <div class="card-overlay"></div>
      <div class="card-body">
        <div class="num">{num}</div>
        <h3>{name}</h3>
        <p>{desc}</p>
      </div>
    </>
  )}
</article>