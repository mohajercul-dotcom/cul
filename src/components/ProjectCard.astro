---
export interface Props {
  name: string;
  desc: string;
  index: number;
  img?: string;
  logo?: string;
  pastel?: string;
  status: "completed" | "in-progress" | "queued";
}
const { name, desc, index, img, logo, pastel, status } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const isPastel = pastel !== undefined;
const style = isPastel ? `--i: ${index}; --pastel: ${pastel}` : `--i: ${index}; --img: url(${img})`;

import { statuses } from "../data/stats.json";
const s = statuses[status];
const hex = s.color;
const r = parseInt(hex.slice(1,3), 16), g = parseInt(hex.slice(3,5), 16), b = parseInt(hex.slice(5,7), 16);
const badgeStyle = `background:rgba(${r},${g},${b},0.25);color:#fff;border:1px solid rgba(${r},${g},${b},0.6);text-shadow:0 1px 3px rgba(0,0,0,0.3)`;
---

<article class="card" class:list={{ "card-pastel": isPastel }} {style}>
  <span class="card-badge" style={badgeStyle}>{s.label}</span>
  {isPastel ? (
    <>
      <div class="card-bg-pastel"></div>
      <div class="card-overlay"></div>
      <div class="card-section card-section-top">
        {logo && <div class="card-logo"><img src={logo} alt="" /></div>}
      </div>
      <div class="card-section card-section-mid"></div>
      <div class="card-section card-section-btm">
        <div class="card-body">
          <div class="num">{num}</div>
          <h3>{name}</h3>
          <p>{desc}</p>
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="card-bg"></div>
      {logo && <div class="card-logo"><img src={logo} alt="" /></div>}
      <div class="card-overlay"></div>
      <div class="card-body">
        <div class="num">{num}</div>
        <h3>{name}</h3>
        <p>{desc}</p>
      </div>
    </>
  )}
</article>