---
interface SidebarItem {
  icon: string;
  label: string;
}

const items: SidebarItem[] = [
  { icon: "home", label: "خانه" },
  { icon: "mail", label: "تماس" },
];
---
<aside class="icon-sidebar">
  <div class="icon-group-top">
    {items.map((item, i) => (
      <div class="icon-btn-container">
        <button class="icon-circle" id={i === 0 ? "homeBtn" : "contactBtn"}>
          <span class="material-symbols-outlined">{item.icon}</span>
        </button>
        <div class="tooltip">{item.label}</div>
      </div>
    ))}
  </div>
</aside>

<!-- Contact Modal -->
<div class="modal-ol" id="contactModal">
  <div class="modal">
    <button class="modal-close" id="modalClose">✕</button>
    <div class="modal-title">تماس با ما</div>
    <div class="modal-body">
      <a href="mailto:mohajercul@gmail.com" class="modal-link">
        <span class="material-symbols-outlined">mail</span>
        <span>تماس از طریق ایمیل</span>
      </a>
      <a href="https://t.me/mohebkhatib" target="_blank" rel="noopener" class="modal-link">
        <span class="material-symbols-outlined">send</span>
        <span>پشتیبانی در تلگرام</span>
      </a>
      <a href="https://t.me/Ghn2459" target="_blank" rel="noopener" class="modal-link">
        <span class="material-symbols-outlined">send</span>
        <span>ارتباط با مدیریت</span>
      </a>
    </div>
  </div>
</div>

<script>
  document.getElementById("homeBtn").addEventListener("click", function () {
    window.location.href = "/";
  });

  var contactBtn = document.getElementById("contactBtn");
  var modal = document.getElementById("contactModal");
  var modalClose = document.getElementById("modalClose");

  contactBtn.addEventListener("click", function () {
    modal.classList.add("open");
  });

  modalClose.addEventListener("click", function () {
    modal.classList.remove("open");
  });

  modal.addEventListener("click", function (e) {
    if (e.target === modal) modal.classList.remove("open");
  });
</script>
