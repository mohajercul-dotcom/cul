            </svg>
            <div class="brand-label">M O H A J E R</div>
          </div>

          <div class="about">
            {paragraphs.map((p) => <p set:html={p} />)}
          </div>

          <div class="menu-circles">
            <button class="icon-circle" id="homeBtn" data-tooltip="خانه"><span class="material-symbols-outlined">home</span></button>
            <button class="icon-circle" id="contactBtn" data-tooltip="تماس با ما"><span class="material-symbols-outlined">forum</span></button>
          </div>

          <div class="stats">
            <div class="stat-item">
              <span class="stat-label"><span class="stat-dot" style="background:{statuses.completed.color}"></span> پروژه تکمیل شده</span>
              <span class="stat-num">{persianNum(completed)}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label"><span class="stat-dot" style="background:{statuses['in-progress'].color}"></span> پروژه در دست ساخت</span>
              <span class="stat-num">{persianNum(inProgress)}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label"><span class="stat-dot" style="background:{statuses.active.color}"></span> پروژه فعال</span>
              <span class="stat-num">
                {pct === 100 && <span class="stat-check">✓</span>}
                {persianNum(pct)}%
              </span>
              <div class="stat-bar">
                <div class={`stat-fill${pct === 100 ? " complete" : ""}`} style={`width:${pct}%`}></div>
              </div>
            </div>
            <div class="stat-item">
              <span class="stat-label"><span class="stat-dot" style="background:{statuses.queued.color}"></span> پروژه در نوبت</span>
              <span class="stat-num">{persianNum(queued)}</span>
            </div>
          </div>
        </div>

        <!-- 2/3 Cards column -->
        <div class="col-cards">
          <div class="top-label">پروژه‌ها · PROJECTS</div>
          <div class="grid">
            {projects.map((p, i) => (
              <ProjectCard name={p.name} desc={p.desc} index={i} img={p.img} logo={p.logo} pastel={p.pastel} status={p.status} />
            ))}
          </div>
        </div>
      </main>
    </div>

    <!-- Modal -->
    <div class="modal-overlay" id="aboutModal">
      <div class="modal-box">
        <button class="modal-close" id="modalClose">
          <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <svg class="mimg" viewBox="0 0 1080 1080" xmlns="http://www.w3.org/2000/svg">
          <path d="M364.94,482.94c-7.81,29.5-15.86,58.4-22.45,87.7-2.82,3.92-5.61,7.81-8.38,11.7l-3.25,4.59c-10.77,15.14-20.97,29.42-33.8,43.16-7.74,8.26-15.81,16.69-24.34,25.39,7.12-31.98,16.62-65.25,28.95-101.93,5.16-15.33,37.52-109.67,59.54-96.08,7.64,4.73,5.9,17.29,3.73,25.48Z"/>
