---
import "../styles/global.scss";
import ProjectCard from "../components/ProjectCard.astro";

interface Project {
  name: string;
  desc: string;
  img?: string;
  logo?: string;
  pastel?: string;
  status: "completed" | "in-progress" | "queued";
}

const projects: Project[] = [
  { name: "مکتبة العلوم", desc: "کتابخانه دیجیتال هزاران جلد کتاب و مقاله در فقه، اصول، حدیث و تفسیر", logo: "/cards/fanoos.svg", pastel: "#B5EAD7", status: "completed" },
  { name: "نور الهدی", desc: "دانشنامه تعاملی قرآن با جستجوی پیشرفته، تفسیر تطبیقی و ترجمه چندزبانه", logo: "/cards/sahaba.svg", pastel: "#FFDAC1", status: "in-progress" },
  { name: "وقت الصلاة", desc: "سامانه اوقات شرعی با قبله‌نما، تقویم اسلامی و یادآوری اذان هوشمند", img: "/cards/card3.jpg", status: "queued" },
  { name: "سوق البركة", desc: "بازارچه محصولات فرهنگی و مذهبی، کتب نفیس و نرم‌افزارهای دینی", img: "/cards/card4.jpg", status: "queued" },
  { name: "منبر الحکمة", desc: "پایگاه سخنرانی‌ها و مقالات اساتید برجسته در موضوعات اعتقادی و اخلاقی", img: "/cards/card5.jpg", status: "queued" },
  { name: "دار السلام", desc: "شبکه اجتماعی خانواده محور با رویکرد سبک زندگی اسلامی و محتوای سالم", img: "/cards/card6.jpg", status: "queued" },
];

import data from "../data/stats.json";
import aboutRaw from "../data/about.txt?raw";
const { stats: statsData, statuses } = data;
const paragraphs = aboutRaw.trim().split(/\n\n+/).map(p => p.replace(/\*([^*]+)\*/g, '<strong>$1</strong>').replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>'));
const { completed, inProgress, queued, activePercent: pct } = statsData;

function persianNum(n: number): string {
  return String(n).replace(/\d/g, (d: string) => "۰۱۲۳۴۵۶۷۸۹"[parseInt(d)]);
}
---

