<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>مهاجر | گروه فرهنگی</title>
    <meta name="description" content="گروه فرهنگی مهاجر — مجموعه پروژه‌های مستقل در حوزه علوم و معارف اسلامی" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@200;300;400;900&display=swap" rel="stylesheet">
