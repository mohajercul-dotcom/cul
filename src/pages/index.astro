        </svg>
        <h2>درباره ما</h2>
        <div class="msub">بوستان معرفت</div>
        <div class="mdiv"></div>
        <p>مجموعه بوستان معرفت شامل چهار پروژه مستقل در حوزه علوم و معارف اسلامی است. هر پروژه با تیم و وبسایت جداگانه فعالیت می‌کند.</p>
      </div>
    </div>

    <!-- Contact Modal -->
    <div class="modal-ol" id="contactModal">
      <div class="modal">
        <button class="modal-close" id="contactModalClose">✕</button>
        <div class="modal-header">
          <div class="modal-icon material-symbols-outlined">forum</div>
          <div class="modal-title">تماس با ما</div>
          <div class="modal-sub">راه‌های ارتباطی</div>
        </div>
        <div class="modal-body">
          <a href="mailto:mohajercul@gmail.com" class="modal-link">
            <span class="ml-icon material-symbols-outlined">mail</span>
            <span class="ml-text">تماس از طریق ایمیل</span>
            <span class="ml-arrow material-symbols-outlined">chevron_left</span>
          </a>
          <a href="https://t.me/mohebkhatib" target="_blank" rel="noopener" class="modal-link">
            <span class="ml-icon material-symbols-outlined">send</span>
            <span class="ml-text">پشتیبانی در تلگرام</span>
            <span class="ml-arrow material-symbols-outlined">chevron_left</span>
          </a>
          <a href="https://t.me/Ghn2459" target="_blank" rel="noopener" class="modal-link">
            <span class="ml-icon material-symbols-outlined">person</span>
            <span class="ml-text">ارتباط با مدیریت</span>
            <span class="ml-arrow material-symbols-outlined">chevron_left</span>
          </a>
        </div>
      </div>
    </div>

    <script>
      document.body.classList.add("dark");

      function lockScroll() { document.body.style.overflow = "hidden"; }
      function unlockScroll() { document.body.style.overflow = ""; }

      document.getElementById("homeBtn").addEventListener("click", function () {
        window.location.href = "/";
      });

      var contactBtn = document.getElementById("contactBtn");
      var modal = document.getElementById("contactModal");
      var modalClose = document.getElementById("contactModalClose");

      contactBtn.addEventListener("click", function () {
        modal.classList.add("open");
        lockScroll();
      });

      modalClose.addEventListener("click", function () {
        modal.classList.remove("open");
        unlockScroll();
      });

      modal.addEventListener("click", function (e) {
        if (e.target === modal) {
          modal.classList.remove("open");
          unlockScroll();
        }
      });
    </script>
  </body>
</html>
