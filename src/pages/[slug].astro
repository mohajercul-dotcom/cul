---
import "../styles/global.scss";
import ChevronLeftIcon from "../components/icons/ChevronLeftIcon.astro";
import GlobeIcon from "../components/icons/GlobeIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import ShareIcon from "../components/icons/ShareIcon.astro";
import DownloadIcon from "../components/icons/DownloadIcon.astro";

export async function getStaticPaths() {
  const allModules = import.meta.glob('../data/*.md', { eager: true });
  const modules = Object.fromEntries(Object.entries(allModules).filter(([k, v]) => v.frontmatter?.slug));
  return Object.values(modules).map((mod: any) => ({
    params: { slug: mod.frontmatter.slug },
    props: { project: mod },
  }));
}

const { project } = Astro.props;
const { frontmatter, Content } = project;
const p = frontmatter;
const hasPdfs = p.pdfs && p.pdfs.filter((f: any) => f.file).length > 0;
const firstPdf = hasPdfs ? p.pdfs.filter((f: any) => f.file)[0] : null;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{p.name}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@200;300;400;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="project-page">
      <div class="project-card">
        <div class="project-toolbar">
          <a href="/" class="back-link" data-tooltip="صفحه اصلی">
            <ChevronLeftIcon class="back-icon" />
            بازگشت
          </a>
          <div class="toolbar-actions">
            <button class="toolbar-btn" id="fontSizeBtn" data-tooltip="تغییر اندازه متن">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
            </button>
            <button class="toolbar-btn" id="printBtn" data-tooltip="پرینت صفحه">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            </button>
          </div>
        </div>

        <header class="project-header">
          <h1>{p.name}</h1>
          {p.tagline && <p class="project-tagline">{p.tagline}</p>}
        </header>

        <div class="project-content" id={`${p.slug}-content`}>
          <Content />
        </div>

        {hasPdfs && (
          <div class="project-download">
            <div class="download-info">
              <h4>دانلود فایل پروژه</h4>
              <p>فایل معرفی «{p.name}» را دانلود کنید.</p>
            </div>
            <a href={firstPdf.file} download class="download-btn">
              <DownloadIcon class="download-icon" />
              <span>دانلود (PDF)</span>
            </a>
          </div>
        )}

        <div class="project-links">
          {p.links?.site && (
            <a href={p.links.site} target="_blank" rel="noopener" class="project-link" data-tooltip="وبسایت پروژه">
              <GlobeIcon class="pl-icon" />
            </a>
          )}
          {p.links?.telegram && (
            <a href={p.links.telegram} target="_blank" rel="noopener" class="project-link" data-tooltip="کانال تلگرام">
              <SendIcon class="pl-icon" />
            </a>
          )}
          {p.links?.instagram && (
            <a href={p.links.instagram} target="_blank" rel="noopener" class="project-link" data-tooltip="اینستاگرام">
              <InstagramIcon class="pl-icon" />
            </a>
          )}
        </div>

        <div class="project-actions">
          <button class="action-btn" id="shareBtn" data-title={p.name} data-intro={p.intro ? p.intro.split('\n').filter((l: string) => l.trim()).map((l: string) => l.trim()).join('\n') : ''}>
            <ShareIcon class="action-icon" />
            <span>اشتراک‌گذاری</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      document.body.classList.add("dark");

      document.getElementById("shareBtn")?.addEventListener("click", function() {
        var title = this.getAttribute("data-title");
        var intro = (this.getAttribute("data-intro") || "")
          .replace(/\\n/g, "\n")
          .replace(/^#(.+)$/gm, "*$1*");
        var url = window.location.href;
        var shareText = intro + "\n\nبرای دیدن ادامه به لینک زیر مراجعه کنید:\n" + url;
        var span = this.querySelector("span");
        if (navigator.share) {
          navigator.share({ text: shareText });
        } else {
          navigator.clipboard.writeText(shareText);
          if (span) span.textContent = "کپی شد!";
          var btn = this;
          setTimeout(function() {
            if (span) span.textContent = "اشتراک‌گذاری";
          }, 2000);
        }
      });

      var fontSizes = [0.85, 1, 1.15, 1.3, 1.4];
      var fontIdx = 1;
      var headingSizes = [1.1, 1.3, 1.5, 1.7, 1.9];
      document.getElementById("fontSizeBtn")?.addEventListener("click", function() {
        fontIdx = (fontIdx + 1) % fontSizes.length;
        var el = document.querySelector(".project-content");
        if (el) el.style.fontSize = fontSizes[fontIdx] + "rem";
        var h2s = document.querySelectorAll(".project-content h2");
        var h3s = document.querySelectorAll(".project-content h3");
        h2s.forEach(function(h) { h.style.fontSize = headingSizes[fontIdx] + "rem"; });
        h3s.forEach(function(h) { h.style.fontSize = (headingSizes[fontIdx] - 0.2) + "rem"; });
      });

      document.getElementById("printBtn")?.addEventListener("click", function() {
        window.print();
      });
    </script>
  </body>
</html>
